# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# External opportunities provider — Arbeitnow public Job Board API.
# FREE and requires NO API key / authentication. Leave this unset to use
# the built-in default (https://www.arbeitnow.com/api/job-board-api); only
# set it to point at a mirror or a compatible provider.
#   Docs: https://www.arbeitnow.com/blog/job-board-api
# VITE_OPPORTUNITIES_API_URL=https://www.arbeitnow.com/api/job-board-api
#
# No API key is needed for this provider, so there is intentionally no
# VITE_OPPORTUNITIES_API_KEY here — do not add one.
